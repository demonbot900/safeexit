# Kopie als .env anlegen. .env wird nie eingecheckt.

# --- Backend, gemeinsam ---
NODE_ENV=development
# memory = ohne Datenbank starten (Entwicklung, Demo, Tests)
# postgres = echte Datenbank, DATABASE_URL wird dann gebraucht
STORAGE=memory
DATABASE_URL=postgres://safeexit:safeexit@localhost:5432/safeexit

# --- API-Dienst (Shop, Konto, Warteliste) ---
API_PORT=3000

# --- Alarmdienst (getrennt vom API-Dienst, siehe docs/entscheidungen/0002) ---
ALARM_PORT=3001
# Sekunden ohne Quittierung, bis Stufe 1 auf Stufe 2 hochgestuft wird
ESCALATION_TIMEOUT_SECONDS=90
# Umkreis in Metern, in dem Partnerbetriebe bei Stufe 2 alarmiert werden
NETWORK_RADIUS_METERS=300
# Stunden, nach denen Standortdaten gelöscht werden
LOCATION_RETENTION_HOURS=24

# --- Webseite ---
# Von der Next.js-Route /api/waitlist serverseitig aufgerufen
BACKEND_API_URL=http://localhost:3000
