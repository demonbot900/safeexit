{
  "name": "@safeexit/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev:api": "node --import @swc-node/register/esm-register --watch src/main.api.ts",
    "dev:alarm": "node --import @swc-node/register/esm-register --watch src/main.alarm.ts",
    "start:api": "node dist/main.api.js",
    "start:alarm": "node dist/main.alarm.js",
    "db:migrate": "node --import @swc-node/register/esm-register src/persistence/postgres/migrate.ts",
    "db:seed": "node --import @swc-node/register/esm-register src/persistence/postgres/seed.ts",
    "simulate:button": "node --import @swc-node/register/esm-register scripts/simulate-button.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@safeexit/api-contracts": "*",
    "@safeexit/protocols": "*",
    "@safeexit/shared-types": "*",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.3",
    "@swc-node/register": "^1.12.1",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2"
  }
}
